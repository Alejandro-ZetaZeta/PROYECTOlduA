---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Eventos deportivos e integración estudiantil organizados por LDU-A ULEAM (Extensión Chone)." } = Astro.props;

// Preconnect to the InsForge API so the admin/registration round-trip doesn't
// pay the DNS+TLS cost on first request. (The middleware pings it on every
// server-rendered page; client islands hit it directly on /registro-torneo.)
const INSFORGE_URL = import.meta.env.PUBLIC_INSFORGE_URL;
const INSFORGE_ANON_KEY = import.meta.env.PUBLIC_INSFORGE_ANON_KEY;
const insforgeOrigin = (() => {
  try {
    return new URL(INSFORGE_URL).origin;
  } catch {
    return undefined;
  }
})();
---

<!doctype html>
<html lang="es" class="h-full antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#05060b" />
    <meta name="color-scheme" content="dark" />

    {/* Site-wide resource hints. The LCP image + display font preloads live
        in <Hero />, not here — /registro-torneo and /404 don't render the
        hero, so preloading those assets there triggers a browser warning
        ("preloaded but not used within a few seconds"). */}
    {insforgeOrigin && (
      <>
        <link rel="preconnect" href={insforgeOrigin} crossorigin />
        <link rel="dns-prefetch" href={insforgeOrigin} />
      </>
    )}

    <link rel="icon" type="image/png" href="/icon.png?icon.0zbxbt_8_e007.png" />
    <title>{title}</title>
    <meta name="description" content={description} />

    {/* Server-injected InsForge config. The InsForge SDK hard-codes
        `NEXT_PUBLIC_INSFORGE_*` (Next.js convention) in its env-var fallback,
        and Astro only inlines `import.meta.env.PUBLIC_*` at BUILD time — so
        if the var is missing at build, the browser bundle ships with
        `undefined` and createBrowserClient() throws. Setting it on
        `window` at request time side-steps both problems. */}
    {INSFORGE_URL && INSFORGE_ANON_KEY && (
      <script
        is:inline
        set:html={`window.__INSFORGE_CONFIG__={baseUrl:${JSON.stringify(INSFORGE_URL)},anonKey:${JSON.stringify(INSFORGE_ANON_KEY)}};`}
      />
    )}

    <ClientRouter />
  </head>
  <body class="relative min-h-full flex flex-col overflow-x-hidden">
    <slot />
  </body>
</html>

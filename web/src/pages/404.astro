---
import BaseLayout from "../layouts/BaseLayout.astro";

export const prerender = true;
---

<BaseLayout title="404 · LDU-A ULEAM" description="Página no encontrada.">
  <main class="relative mx-auto flex min-h-[60vh] w-full max-w-3xl flex-col items-center justify-center px-6 py-20 text-center sm:px-10">
    <p class="text-[0.6rem] tracking-[0.32em] text-gold">404</p>
    <h1 class="mt-5 font-display text-4xl tracking-tight text-foreground sm:text-5xl">
      Página no encontrada
    </h1>
    <p class="mt-5 max-w-md text-sm leading-[1.8] text-muted sm:text-base">
      La ruta que buscás no existe o fue movida. Volvé al inicio para ver los eventos disponibles.
    </p>
    <a
      href="/"
      class="mt-8 inline-flex items-center gap-2 rounded-full border border-gold/40 bg-gold/10 px-5 py-2.5 text-xs tracking-[0.18em] text-gold transition-colors hover:bg-gold/20 hover:border-gold/70"
    >
      Volver al inicio
    </a>
  </main>
</BaseLayout>

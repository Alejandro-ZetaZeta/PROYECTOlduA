---
// Hero — server-rendered, no JS. Replaces app/activate-uleam/sections/Hero.tsx.
// The original used framer-motion's whileInView; in Astro we keep the visual
// identical and add the same reveal behavior via a tiny Reveal island below.
import Reveal from "./Reveal";

interface Props {
  hero: {
    title: string;
    subtitle1: string;
    subtitle2: string;
    presentedBy: string;
  };
}

const { hero } = Astro.props;
---

{/* LCP preloads — scoped to pages that render this hero, so /registro-torneo
    and /404 don't ship wasted preload hints. The body-positioned <link>
    tags are still honored by the browser parser. */}
<link rel="preload" href="/Kunaroh.ttf" as="font" type="font/ttf" crossorigin="anonymous" />
<link rel="preload" as="image" href="/LOGO-ULEAM.svg" fetchpriority="high" />

<section class="relative pb-20 pt-20 sm:pb-28 sm:pt-24 lg:pb-36 lg:pt-28">
  <div class="mx-auto w-full max-w-6xl px-6 sm:px-10">

    {/* Institution logos — slide in from each end.
        LCP candidates: width/height (prevents CLS), fetchpriority="high"
        on the leftmost so it loads alongside the critical CSS,
        decoding="async" so the parser isn't blocked on it. */}
    <div class="relative mb-8 flex items-center justify-between sm:mb-10">
      <img
        src="/LOGO-ULEAM.svg"
        alt="ULEAM"
        width="96"
        height="96"
        decoding="async"
        fetchpriority="high"
        class="h-12 w-auto opacity-80 invert md:h-16 lg:h-24"
      />

      {/* Center icon */}
      <img
        src="/choneRe.png"
        alt="Chone"
        width="96"
        height="96"
        decoding="async"
        class="absolute left-1/2 h-12 w-auto -translate-x-1/2 opacity-90 md:h-16 lg:h-24"
      />

      <img
        src="/LDUA_BLANCO.png"
        alt="LDU-A"
        width="96"
        height="96"
        decoding="async"
        class="h-12 w-auto opacity-80 md:h-16 lg:h-24"
      />
    </div>

    {/* Kicker: reduced tracking on mobile to prevent overflow */}
    <Reveal client:load>
      <p class="text-center text-[0.6rem] tracking-[0.18em] text-gold sm:text-xs sm:tracking-[0.32em] lg:text-left">
        LDU-A ULEAM &nbsp;·&nbsp; {hero.subtitle1}
      </p>
    </Reveal>

    <Reveal client:load delay={0.07}>
      <h1 class="mt-7 w-full text-center font-kunaroh text-5xl leading-[0.94] tracking-[0.04em] text-foreground sm:text-7xl lg:text-[7rem] xl:text-[8rem]">
        {hero.title}
      </h1>
    </Reveal>

    <Reveal client:load delay={0.14}>
      <p class="mx-auto mt-5 max-w-xl text-pretty text-center text-sm leading-[1.8] text-muted sm:mt-7 sm:text-base lg:text-lg">
        {hero.subtitle2}
      </p>
    </Reveal>

    <Reveal client:load delay={0.2}>
      <div class="mt-8 flex flex-col items-center gap-4 sm:mt-10 lg:flex-row lg:items-center lg:gap-8">
        <div class="inline-flex flex-col gap-2 border-l-2 border-gold/40 pl-5">
          <p class="text-[0.6rem] tracking-[0.3em] text-gold/70 sm:text-[0.65rem] sm:tracking-[0.34em]">
            PRESENTA
          </p>
          <p class="max-w-lg text-xs leading-[1.75] text-foreground/75 sm:text-sm">
            {hero.presentedBy}
          </p>
        </div>
        <img
          src="/stickdown.png"
          alt=""
          aria-hidden="true"
          width="160"
          height="320"
          loading="lazy"
          decoding="async"
          class="h-28 w-auto self-center opacity-80 mix-blend-screen sm:h-32 lg:h-32 lg:self-auto xl:h-40"
        />
      </div>
    </Reveal>

    <Reveal client:load delay={0.26}>
      <div class="mt-10 h-px w-20 bg-gradient-to-r from-gold/50 to-transparent sm:mt-12"></div>
    </Reveal>

  </div>
</section>
